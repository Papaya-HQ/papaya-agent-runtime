#!/usr/bin/env sh
# Thin launcher for the ppy control plane. Runs inside the repo's uv environment.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
# Pin the instance to this checkout. Without this, `ppy` resolves `.ppy/` from the
# caller's working directory, so the same command run from another directory
# silently targets a different (usually empty) instance. An explicit PPY_HOME
# still wins, for tests and multi-instance setups.
export PPY_HOME="${PPY_HOME:-$ROOT/.ppy}"
VENV="${UV_PROJECT_ENVIRONMENT:-$ROOT/.venv}"

# The interpreter series is the checkout's, not the invoker's. Left to uv, the
# desktop app (managed-only interpreters from its own install dir) and a shell
# (`.python-version` from the user's uv) picked different series for the same
# project, and each side's `uv run` rebuilt the environment for itself.
PYTHON=""
if [ -f "$ROOT/.python-version" ]; then
    PYTHON="$(tr -d '[:space:]' <"$ROOT/.python-version")"
fi

# `capabilities` on a checkout nobody has synced yet.
#
# Every other command goes through `uv run`, and a checkout with no environment
# builds one first: on a machine with no uv cache that is a download of
# sixty-odd packages. The Papaya client's connect-time probe asks this one
# question and gives the answer ten seconds, so a fresh clone — exactly the
# machine somebody has just pointed the desktop app at — would time out on it.
#
# So when the project environment does not exist yet, this one command is
# answered by the runtime's own module under a bare interpreter: no uv, no
# network, no client import, no state. It is the same `capabilities.collect()`
# the full CLI prints, so there is no second document to drift, and
# `client_version: null` is the honest answer on a checkout with nothing
# installed in it. Anything unexpected (no python3, an interpreter too old to
# import the module) falls through to `uv run` and simply takes as long as it
# takes.
if [ "${1:-}" = "capabilities" ] && [ ! -d "$VENV" ]; then
    if command -v python3 >/dev/null 2>&1; then
        shift
        python3 -m papaya_agent_runtime.capabilities "$@" && exit 0
        set -- capabilities "$@"
    fi
fi

# `setup` is the first command on a fresh machine, and everything below needs uv,
# so a machine without it hears the one line that installs it.
if [ "${1:-}" = "setup" ] && ! command -v uv >/dev/null 2>&1; then
    echo "uv is not installed. Install it: curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
    echo "then open a new shell and run ./bin/ppy setup again" >&2
    exit 1
fi

# Does the runtime's dependency import from the environment? A refused or
# interrupted sync used to leave it without the Papaya client (2026-09-16).
environment_ok() {
    [ -x "$VENV/bin/python" ] && "$VENV/bin/python" -c "import papaya_agent_client" >/dev/null 2>&1
}

# The standard-library helpers (`envsync`, `takeover`) run under whatever
# interpreter works: the environment's, a system python3, or uv's own for the
# pinned series. None of them needs the environment to import.
helper() {
    if [ -x "$VENV/bin/python" ] && "$VENV/bin/python" -c "" >/dev/null 2>&1; then
        "$VENV/bin/python" -m "$@"
    elif command -v python3 >/dev/null 2>&1; then
        python3 -m "$@"
    else
        uv run --no-project ${PYTHON:+--python "$PYTHON"} python -m "$@"
    fi
}

# The environment is built once, never under a running `serve`.
#
# `uv run` re-syncs whenever it decides the environment is stale, and a sync
# deletes the interpreter and packages a live `serve` is importing from — which
# is how a `ppy status` in a terminal killed the app's manager on 2026-09-16. So
# only three things sync: `ppy serve` as it starts (when the environment is out
# of date or broken), an explicit `ppy env sync`, and first use on a checkout
# with no environment. `envsync` refuses while the supervisor lock is held and
# names the pid; it builds into a fresh directory and swaps it in only once the
# client imports from it, so a refused or interrupted sync leaves the previous
# environment as it was.
sync_env() {
    helper papaya_agent_runtime.envsync --project "$ROOT" ${PYTHON:+--python "$PYTHON"} "$@"
}

# Commands that must work when the environment is refused or broken — above all
# `ppy supervisor stop`, which is how a person clears a supervisor in the way.
# They never sync: from the environment when it imports, else from the source
# tree under uv's interpreter for the pinned series.
case "${1:-} ${2:-}" in
    "supervisor stop" | "supervisor status" | "version "* | "doctor "* | "blockers "*)
        if environment_ok; then
            exec uv run --no-sync --project "$ROOT" ${PYTHON:+--python "$PYTHON"} python -m papaya_agent_runtime "$@"
        fi
        exec uv run --no-project ${PYTHON:+--python "$PYTHON"} python -m papaya_agent_runtime "$@"
        ;;
esac

if [ "${1:-}" = "env" ] && [ "${2:-}" = "sync" ]; then
    sync_env
    exit $?
fi

if [ "${1:-}" = "serve" ]; then
    # Take over from whatever holds the supervisor lock *before* syncing: a stale
    # holder is cleared, a live supervisor of this build is adopted (and nothing is
    # rebuilt under it), one of another build is asked to stop and retired. Only
    # then can the sync's refusal be about a supervisor this start chose to keep.
    broken=""
    environment_ok || broken="--environment-broken"
    decision=0
    helper papaya_agent_runtime.takeover --project "$ROOT" $broken || decision=$?
    case "$decision" in
        0) sync_env --if-needed --record-failure || exit $? ;;
        3) ;; # adopted: its environment is this build's, and it is running from it
        *) exit "$decision" ;;
    esac
elif [ ! -d "$VENV" ]; then
    sync_env || exit $?
fi

exec uv run --no-sync --project "$ROOT" ${PYTHON:+--python "$PYTHON"} python -m papaya_agent_runtime "$@"
