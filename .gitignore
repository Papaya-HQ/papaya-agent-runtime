# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# uv keeps the resolved lockfile (uv.lock) in git; the .venv it builds is local.

# Node — companion tools install under .ppy/tools/ (ignored below); ignore any
# stray top-level installs too.
node_modules/

# Secrets and local environment (never commit credentials or tokens).
.env
.env.*
!.env.example

# Logs and scratch
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Papaya Agent Runtime runtime state — canonical, machine-local state is gitignored per
# the design. Everything under .ppy/ is regenerated by `ppy` and must never be
# committed: the config, the SQLite source of truth, read-only base clones, per-run
# plans/results/event logs, locally provisioned + checksum-verified companion
# tools, task worktree pools, durable memory, supervisor sockets, and raw
# provider-probe evidence.
.ppy/

# Review surfaces and their feedback/pid sidecars are local working files, not a
# tracker to commit (see AGENTS.md "No trackers in the repo").
.lavish/
